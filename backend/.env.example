# ==========================================
# Bugveil — Backend Environment Template
# ==========================================

# Application Settings
PROJECT_NAME="Bugveil"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration
# Default: Local SQLite database with aiosqlite for zero external dependencies
# Production: postgresql+asyncpg://user:password@localhost:5432/bugveil
DATABASE_URL="sqlite+aiosqlite:///./bugveil.db"

# Groq AI Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Storage Configuration for Cloned / Uploaded Repositories
STORAGE_DIR="./data/storage"
MAX_UPLOAD_SIZE_MB=50
MAX_UNCOMPRESSED_SIZE_MB=150
MAX_FILE_COUNT=2500
